<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
</head>
<body>
  <%- include("../partials/header") %>

  <main class="page">
    <section class="page-card">
      <h1>Locations</h1>
      <% if (currentUser) { %>
        <p><a href="/locations/new">Add Location</a></p>
      <% } %>

      <% if (locations.length === 0) { %>
        <p>No locations yet.</p>
      <% } else { %>
        <table class="datatable">
          <thead>
            <tr>
              <th>Name</th>
              <th>Description</th>
              <th>Active</th>
              <th>Latitude</th>
              <th>Longitude</th>
              <th>Edit</th>
            </tr>
          </thead>
          <tbody>
            <% locations.forEach(location => { %>
              <tr>
                <td><%= location.name %></td>
                <td><%= location.description || "" %></td>
                <td><%= location.active === 1 ? "Active" : "Inactive" %></td>
                <td><%= location.latitude || "" %></td>
                <td><%= location.longitude || "" %></td>
                  <td>
                    <% if (currentUser) { %>
                      <a href="/locations/<%= location.id %>/edit" class="icon-link" aria-label="edit">
                        <svg class="icon">
                          <use href="/public/icons/icons.svg#stylus"></use>
                        </svg>
                      </a>
                    <% } else { %>
                      N/A
                    <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>